# AgriSaarthi AI Environment Configuration

# Agent Identity and Network
AGRI_AGENT_NAME=agrisaarthi_crop_advisor
AGRI_AGENT_SEED=agrisaarthi_secure_seed_phrase_demo_2026_fetchathon
AGRI_AGENT_PORT=8000
AGRI_AGENT_ENDPOINT=http://127.0.0.1:8000/submit
AGENT_NETWORK=testnet

# Agentverse Mailbox (uagents 0.26.1: boolean only).
# true  -> agent registers the Agentverse mailbox endpoint; finish setup in the
#          Local Agent Inspector (Connect -> Mailbox). No key is needed here.
# false -> agent uses AGRI_AGENT_ENDPOINT (127.0.0.1 is NOT reachable by ASI:One).
ENABLE_AGENTVERSE_MAILBOX=true
AGENTVERSE_API_KEY=

# ASI:One Integration (Optional for LLM orchestration)
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai

# Environment Mode: development / production / test
ENVIRONMENT=development
